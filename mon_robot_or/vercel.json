{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{index.html,app.js,moteur.js,marches.js,ia.js,analyse.js,serveur.py,comptes.py}"
    }
  },
  "rewrites": [
    { "source": "/((?!api/index).*)", "destination": "/api/index?__p=/$1" }
  ]
}
